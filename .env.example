# chain
# CHAIN is one of: fake, anvil, bsctest
CHAIN=fake
RPC_URL=
OPERATOR_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
# The phone wallet's address. Its private key never goes in this file.
OWNER_ADDRESS=
BSCSCAN_API_KEY=
# The wallet pair to start on, as an index into deployments/<chainId>.json. Default 0.
# On testnet, set it past the pairs you already used. pnpm demo:local sets it to 0.
PAIR=0

# model
LLM_BASE_URL=
LLM_API_KEY=
# Optional. Empty means qwen/qwen3.8-flash, the model card X1 picked.
LLM_MODEL=

# web
NEXT_PUBLIC_MOCK=0
API_URL=http://localhost:8787
